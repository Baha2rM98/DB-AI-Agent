# Application settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LLM_MODEL=gemini-1.5-pro
GOOGLE_API_KEY=your_google_api_key

# Primary database settings
DB_HOST=postgres
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_NAME=db_ai_agent

# LangGraph checkpoint persistence
CHECKPOINTER_BACKEND=postgres
CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/db_ai_agent
CHECKPOINTER_SQLITE_PATH=/app/checkpoints.db
