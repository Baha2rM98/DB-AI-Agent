# Application settings
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=INFO
LLM_MODEL=gemini-1.5-flash
GOOGLE_API_KEY=your_google_api_key

# Target database settings. This is the external database users ask about.
# You can use TARGET_DATABASE_URL directly, or the TARGET_DB_* fields below.
TARGET_DATABASE_URL=
TARGET_DB_HOST=postgres
TARGET_DB_PORT=5432
TARGET_DB_USER=postgres
TARGET_DB_PASSWORD=postgres
TARGET_DB_NAME=db_name
ALLOW_TARGET_WRITES=false
ALLOW_TARGET_DELETES=false

# Seconds to cache the inspected target-database schema before re-reading it.
SCHEMA_CACHE_TTL_SECONDS=300

# Auto-append LIMIT to SELECTs that have none (0 disables).
MAX_SELECT_ROWS=1000
# Absolute cap on rows materialized into memory per query (0 disables).
MAX_RESULT_ROWS=10000

# Target-database connection pool tuning.
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800

# LangGraph checkpoint persistence
CHECKPOINTER_BACKEND=postgres
CHECKPOINTER_DATABASE_URL=postgresql://postgres:postgres@postgres:5432/db_ai_agent
CHECKPOINTER_SQLITE_PATH=/app/checkpoints.db
